# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision

# Signing credentials (NEVER commit)
# google-services.json: config del cliente Firebase (necesaria para FCM).
# Gitignored por precaución, pero SÍ viaja a EAS: el archive lo controla el
# .easignore de la RAÍZ del repo, que no lo excluye.
google-services.json
keystore.properties
android/keystore.properties
android/app/keystore.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
.metro-cache/

# Native folders (regenerated by prebuild / CNG). No las committeamos:
# EAS las regenera limpias en cada build y firma con el keystore remoto.
ios/
android/
